# Symbols (comma-separated), spot 마켓 기준. 예: BTCUSDT,ETHUSDT,SOLUSDT
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
INTERVAL=1m
LIMIT=1000
OUT_DIR=out
# API base
BINANCE_BASE=https://api.binance.com
# microstructure depth
DEPTH_LIMIT=5
# Feature windows
VP_WINDOW=240
RSI_PERIOD=14
EMA_1=25
EMA_2=50
EMA_3=100
ATR_PERIOD=22
# Augmentation
AUG_PER_SAMPLE=2
NEGATIVE_RATIO=0.15
# Train/Val split(0~1)
VAL_RATIO=0.1
